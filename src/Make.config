# -*- makefile -*-

SHELL = /bin/sh

VPATH = $(SRCDIR)

# Set GCCPREFIX to the customized prefix, if any. Leave empty if the prefix is
# i386-elf-. Use ?= (not =) so an exported GCCPREFIX from the environment
# isn't clobbered by this makefile.
GCCPREFIX ?=

# Infer the correct GCCPREFIX. Checked via `command -v` on the compiler
# itself, not by grepping `objdump -i`'s BFD target list: binutils built for
# a non-x86 host (e.g. aarch64) can list elf32-i386 as a *readable* format
# without `as`/`ld` actually being able to assemble/link for it, which used
# to produce a false-positive match on the native toolchain.
ifndef GCCPREFIX
GCCPREFIX := $(shell if command -v i386-elf-gcc >/dev/null 2>&1; \
  then echo 'i386-elf-'; \
  elif command -v i686-linux-gnu-gcc >/dev/null 2>&1; \
  then echo 'i686-linux-gnu-'; \
  elif objdump -i 2>&1 | grep '^elf32-i386$$' >/dev/null 2>&1; \
  then echo ''; \
  else echo "***" 1>&2; \
  echo "*** Error: Could not find i386-*-elf compiler toolchain." 1>&2; \
  echo "*** Make sure i386-*-elf-gcc is in your PATH" 1>&2; \
  echo "*** If your i386-*-elf toolchain has a prefix" 1>&2; \
  echo "*** other than 'i386-elf-', set the GCCPREFIX" 1>&2; \
  echo "*** environment variable to that prefix and run 'make' again." 1>&2; \
  echo "***" 1>&2; exit 1; fi)
endif

CC  = $(GCCPREFIX)gcc
AS  = $(GCCPREFIX)as
AR  = $(GCCPREFIX)ar
LD  = $(GCCPREFIX)ld
NM  = $(GCCPREFIX)nm
RANLIB = $(GCCPREFIX)ranlib
OBJCOPY = $(GCCPREFIX)objcopy
OBJDUMP = $(GCCPREFIX)objdump

ifeq ($(strip $(shell command -v $(CC) 2> /dev/null)),)
$(warning *** Compiler ($(CC)) not found.  Did you set $$PATH properly?  Please refer to the Getting Started section in the documentation for details. ***)
endif

# Compiler and assembler invocation.
DEFINES =
WARNINGS = -Wall -W -Wstrict-prototypes -Wmissing-prototypes -Wsystem-headers
CFLAGS = -m32 -g -msoft-float -O0
CPPFLAGS = -nostdinc -I$(SRCDIR) -I$(SRCDIR)/lib
ASFLAGS = -Wa,--gstabs,--32
LDFLAGS = 
# LDOPTIONS will be applied directly with 'ld' while LDFLAGS will be applied with 'gcc'.
LDOPTIONS = -melf_i386
DEPS = -MMD -MF $(@:.o=.d)

# Turn off -fstack-protector, which we don't support.
ifeq ($(strip $(shell echo | $(CC) -fno-stack-protector -E - > /dev/null 2>&1; echo $$?)),0)
CFLAGS += -fno-stack-protector
endif

# Restore pre-GCC10 tentative-definition semantics: several Pintos headers
# (e.g. filesys/filesys.h) declare globals like `struct block *fs_device;`
# without `extern`, relying on the old -fcommon merging behavior across
# translation units. GCC 10+ defaults to -fno-common, turning that into a
# link-time "multiple definition" error.
ifeq ($(strip $(shell echo | $(CC) -fcommon -E - > /dev/null 2>&1; echo $$?)),0)
CFLAGS += -fcommon
endif

# Turn off PIE/PIC, which modern host GCC defaults to. Pintos objcopy's a
# flat binary with no relocation pass, so GOT-relative accesses (e.g. static
# const struct lookups) silently read garbage/zero at runtime.
ifeq ($(strip $(shell echo | $(CC) -fno-pie -E - > /dev/null 2>&1; echo $$?)),0)
CFLAGS += -fno-pie -fno-pic
LDFLAGS += -no-pie
endif

# Turn off --build-id in the linker, which confuses the Pintos loader.
ifeq ($(strip $(shell $(LD) --help | grep -q build-id; echo $$?)),0)
LDFLAGS += -Wl,--build-id=none
endif

PINTOS = $(SRCDIR)/utils/pintos
QEMU = qemu-system-i386
